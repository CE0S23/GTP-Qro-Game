  m_Name: 
  m_EditorClassIdentifier: GTP.Runtime::GTP.NarrativeInteractable
  prompt: Hablar con Orlando
  lines:
  - speaker: Orlando
    text: "\xBFQu\xE9 onda? \xBFBuscando lo mismo?"
  - speaker: Protagonista
    text: "El Punto est\xE1 cerrado."
  - speaker: Orlando
    text: "S\xE9 de otro lugar. Est\xE1 caliente con la poli, pero hay."
  - speaker: Pensamiento
    text: "Mi novia no contesta... pero mi amigo dijo que estar\xEDa con ella en
      el parque."
  - speaker: Pensamiento
    text: Puedo seguir buscando... o ir con ellos.
  repeatLines:
  - speaker: Orlando
    text: "\xBFEntonces qu\xE9? \xBFVienes?"
  available: 1
  onFirstFinished:
    m_PersistentCalls:
