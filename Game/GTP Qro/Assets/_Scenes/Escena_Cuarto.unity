  m_Name: 
  m_EditorClassIdentifier: GTP.Runtime::GTP.NarrativeSequence
  lines:
  - speaker: 
    text: "Atardecer en Quer\xE9taro."
  - speaker: Pensamiento
    text: "Otro d\xEDa igual... y ella sigue sin contestar."
  - speaker: Tutorial
    text: "Mu\xE9vete con WASD o flechas. Shift: correr. C: agacharse. E: interactuar.
      Esc: pausa."
  - speaker: Tutorial
    text: "Tienes 3 intentos por nivel. Lee mensajes y recoge bater\xEDas para sumar
      puntos."
  playOnStart: 1
  onFinished:
    m_PersistentCalls:
      m_Calls: []
